# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real credentials.
#
# Required for Auth session refresh and protected routes (FM-0009).
# When unset: public pages still load; protected routes redirect to
# /auth/sign-in?error=supabase_unconfigured and never simulate a session.
# Mapbox is independent and may also be unconfigured.

# --- Supabase --------------------------------------------------------
# Project Settings > API in the Supabase dashboard.
# The anon key is safe to expose to the browser; it is constrained by
# Row Level Security policies, not secrecy. Newer Supabase projects may
# label this a "publishable" key instead of "anon" — same purpose, see
# management/DECISIONS.md ADR-0010.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — never prefix with
# NEXT_PUBLIC_, never send to the client, never log.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mapbox ------------------------------------------------------------
# https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# --- Regrid (server-only) ----------------------------------------------
# Parcel search / ingestion (FM-0012). Never prefix with NEXT_PUBLIC_.
# https://regrid.com/ — API token from your Regrid account.
# When unset: search/import services return unconfigured; build/tests do not
# require a live token (use mocked fetch in unit tests).
REGRID_API_TOKEN=
# Optional override of the Regrid API host (default https://app.regrid.com).
# REGRID_API_BASE_URL=https://app.regrid.com

# --- Site ----------------------------------------------------------------
# Public base URL of this deployment, used for absolute links/metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
